generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  themeMode             String    @default("light")
  themePrimary          String    @default("#1f4b46")
  themeAccent           String    @default("#dceae7")
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  categories           Category[]
  fixedExpenses        FixedExpense[]
  monthlyEntries       MonthlyEntry[]
  creditCards          CreditCard[]
  monthlyIncomePlans   MonthlyIncomePlan[]
  incomeReceipts       IncomeReceipt[]
  savingsDeposits      SavingsDeposit[]
  passwordResetTokens  PasswordResetToken[]
  loginHistory         LoginHistory[]
  aiConversations      AiConversation[]
}

model LoginHistory {
  id          String   @id @default(uuid())
  userId      String
  success     Boolean  @default(true)
  ip          String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  city        String?
  region      String?
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?
  isp         String?
  timezone    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

enum CategoryType {
  expense
  income
}

model Category {
  id                  String               @id @default(uuid())
  userId              String
  name                String
  type                CategoryType         @default(expense)
  color               String?
  icon                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  fixedExpenses       FixedExpense[]
  monthlyEntries      MonthlyEntry[]
  creditCardPurchases CreditCardPurchase[]

  @@index([userId])
}

model FixedExpense {
  id                 String         @id @default(uuid())
  userId             String
  name               String
  description        String?
  /// Valor fixo mensal, ou valor de referência / última média quando isVariableAmount
  amountCents        Int
  /// Contas como energia e água: valor muda todo mês; na geração usa-se o lançamento do mês anterior, se existir
  isVariableAmount   Boolean        @default(false)
  categoryId         String
  dueDay             Int
  isActive           Boolean        @default(true)
  isRecurringMonthly Boolean        @default(true)
  user               User           @relation(fields: [userId], references: [id])
  category           Category       @relation(fields: [categoryId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  monthlyEntries     MonthlyEntry[]

  @@index([userId])
}

enum PaymentMethod {
  cash
  debit
  pix
  credit_card
}

enum MonthlyEntrySourceType {
  variable
  fixed_expense
}

model MonthlyEntry {
  id              String                   @id @default(uuid())
  userId          String
  description     String
  amountCents     Int
  date            DateTime
  competencyMonth String
  categoryId      String
  paymentMethod   PaymentMethod
  sourceType      MonthlyEntrySourceType
  fixedExpenseId  String?
  user            User                     @relation(fields: [userId], references: [id])
  category        Category                 @relation(fields: [categoryId], references: [id])
  fixedExpense    FixedExpense?            @relation(fields: [fixedExpenseId], references: [id])
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([userId])
  @@index([competencyMonth])
}

model CreditCard {
  id         String               @id @default(uuid())
  userId     String
  name       String
  /// Bandeira de pagamento (visa, mastercard, elo, …) para exibição no app
  brand      String?
  /// Cor do cartão na UI (#RRGGBB)
  themeColor String?
  limitCents Int?
  closingDay Int
  dueDay     Int
  isActive   Boolean              @default(true)
  user       User                 @relation(fields: [userId], references: [id])
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  statements Statement[]
  purchases  CreditCardPurchase[]

  @@index([userId])
}

enum StatementStatus {
  open
  closed
  paid
  overdue
}

model Statement {
  id             String                @id @default(uuid())
  creditCardId   String
  referenceMonth String
  periodStart    DateTime
  periodEnd      DateTime
  closingDate    DateTime
  dueDate        DateTime
  status         StatementStatus       @default(open)
  creditCard     CreditCard            @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  installments   PurchaseInstallment[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([creditCardId, referenceMonth])
  @@index([creditCardId])
}

model CreditCardPurchase {
  id                     String                @id @default(uuid())
  creditCardId           String
  categoryId             String
  description            String
  purchaseDate           DateTime
  totalAmountCents       Int
  /// Estorno/crédito do cartão: `totalAmountCents` fica negativo e a compra tem parcela única
  isRefund               Boolean               @default(false)
  isInstallmentPurchase  Boolean               @default(false)
  totalInstallments      Int                   @default(1)
  currentInstallment     Int                   @default(1)
  installmentAmountCents Int?
  creditCard             CreditCard            @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category               Category              @relation(fields: [categoryId], references: [id])
  installments           PurchaseInstallment[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([creditCardId])
}

enum InstallmentStatus {
  pending
  paid
}

model PurchaseInstallment {
  id                String             @id @default(uuid())
  purchaseId        String
  statementId       String
  installmentNumber Int
  totalInstallments Int
  amountCents       Int
  competencyMonth   String
  status            InstallmentStatus  @default(pending)
  purchase          CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  statement         Statement          @relation(fields: [statementId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([statementId])
  @@index([purchaseId])
  @@index([competencyMonth])
}

/// Salário (ou renda) informado manualmente por mês de competência
model MonthlyIncomePlan {
  id                String   @id @default(uuid())
  userId            String
  competencyMonth   String
  salaryCents       Int?
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, competencyMonth])
}

/// Outras rendas recebidas no mês (além do campo salário em MonthlyIncomePlan)
model IncomeReceipt {
  id                String   @id @default(uuid())
  userId            String
  competencyMonth   String
  amountCents       Int
  note              String?
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([competencyMonth])
}

/// Valores guardados / poupança registrados por mês
model SavingsDeposit {
  id                String   @id @default(uuid())
  userId            String
  competencyMonth   String
  amountCents       Int
  note              String?
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([competencyMonth])
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String?
  user      User        @relation(fields: [userId], references: [id])
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  model          String?
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}
